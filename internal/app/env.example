# =============================================================================
#  sslsync — copy to .env, fill in, then run:  make list
#
#  HOW TO READ THE NAMES
#  ---------------------
#  Every server gets a short NAME you choose, e.g. WEB_PROD.
#  Every variable for that server starts with that name:
#
#      WEB_PROD_HOST=...          <NAME>_<SETTING>
#      WEB_PROD_NGINX_CERT=...    <NAME>_<WHAT>_<FILE>   (WHAT = nginx, minio, k8s ...)
#
#  So for a new server you copy one block below, then replace the name
#  everywhere (search & replace WEB_PROD → YOUR_NAME) and change the values.
#
#  NAME rules: UPPER_CASE letters, digits, single "_".  Use <APP>_<ENV>:
#      WEB_PROD, WEB_STAGING, BILLING_PROD, BILLING_PROD_2
#
#  Values with spaces or # $ ' characters: wrap in single quotes.
#      WEB_PROD_PASSWORD='p#ss w$rd'
# =============================================================================


# -----------------------------------------------------------------------------
# STEP 1 — list every server name, comma-separated
# -----------------------------------------------------------------------------
SSLSYNC_SERVERS=WEB_PROD,STORAGE_PROD,K8S_PROD,DB_PROD


# -----------------------------------------------------------------------------
# STEP 2 — the certificate on YOUR laptop (shared by all servers)
# -----------------------------------------------------------------------------
DEFAULT_CERT_FILE=certs/example.com/fullchain.crt     # certificate + CA bundle
DEFAULT_KEY_FILE=certs/example.com/example.com.key    # private key

# Anything that starts with DEFAULT_ applies to every server that does not set
# its own value. Uncomment to change for all servers:
# DEFAULT_PORT=22
# DEFAULT_USER=deploy
# DEFAULT_TIMEOUT=10m


# -----------------------------------------------------------------------------
# STEP 3 — one block per server
#
#   Every server needs:
#     <NAME>_HOST       IP or domain to SSH to
#     <NAME>_USER       SSH user
#     <NAME>_PASSWORD   SSH password (also used for sudo)
#     <NAME>_TARGETS    what on this server uses the certificate:
#                         nginx    – Nginx
#                         apache   – Apache
#                         haproxy  – HAProxy
#                         minio    – MinIO with its own TLS (certs-dir)
#                         postgres – PostgreSQL
#                         k8s      – Kubernetes secrets
#                         files    – only copy the files, nothing to reload
#                       Several are allowed:  nginx,minio
#
#   Then, for EACH target, where its files are ON THE SERVER:
#     <NAME>_<TARGET>_CERT    path of the certificate file
#     <NAME>_<TARGET>_KEY     path of the private key file
#
#   Recommended:
#     <NAME>_GROUP      staging / prod   → make deploy GROUP=staging
#     <NAME>_VERIFY     ports clients use; checked to serve the NEW cert
#                       ":443" means <HOST>:443
#
#   Optional:
#     <NAME>_PORT       SSH port (default 22)
#     <NAME>_SSH_KEY    path to an SSH private key instead of a password
#     <NAME>_SUDO_PASSWORD   only if different from the login password
#     <NAME>_HEALTH     extra command that must succeed before and after
#     <NAME>_<TARGET>_KEY_MODE  e.g. 0600 — permissions the private key must have
#                       (by default only access for "other" users is removed)
#
#   Full list of settings: README.md section 3, or run `make targets`.
# -----------------------------------------------------------------------------


# ===== Example 1: Nginx on a normal server ===================================
WEB_PROD_GROUP=prod
WEB_PROD_HOST=web.example.com
WEB_PROD_USER=deploy
WEB_PROD_PASSWORD=
WEB_PROD_TARGETS=nginx
WEB_PROD_NGINX_CERT=/etc/ssl/certs/example.com.crt
WEB_PROD_NGINX_KEY=/etc/ssl/private/example.com.key
WEB_PROD_VERIFY=:443


# ===== Example 2: Nginx + MinIO on one server, SSH on port 2222 ==============
STORAGE_PROD_GROUP=prod
STORAGE_PROD_HOST=10.0.0.20
STORAGE_PROD_PORT=2222
STORAGE_PROD_USER=admin
STORAGE_PROD_PASSWORD=
STORAGE_PROD_TARGETS=nginx,minio
STORAGE_PROD_NGINX_CERT=/etc/ssl/certs/example.com.crt
STORAGE_PROD_NGINX_KEY=/etc/ssl/private/example.com.key
STORAGE_PROD_MINIO_CERT=/mnt/minio/certs/public.crt
STORAGE_PROD_MINIO_KEY=/mnt/minio/certs/private.key
STORAGE_PROD_VERIFY=:443,:9000,:9001


# ===== Example 3: Kubernetes =================================================
# CERT/KEY: where to put the files on the node (created if missing).
# TLS_SECRETS: secret name(s); updated in every namespace that has them.
# OPAQUE_SECRETS: other secrets as  name:certfield:keyfield
# RESTART: what to restart afterwards,  namespace/deployment/name
K8S_PROD_GROUP=prod
K8S_PROD_HOST=k8s.example.com
K8S_PROD_USER=deploy
K8S_PROD_PASSWORD=
K8S_PROD_TARGETS=k8s
K8S_PROD_K8S_CERT=/root/ssl/tls.crt
K8S_PROD_K8S_KEY=/root/ssl/tls.key
K8S_PROD_K8S_TLS_SECRETS=example-tls
K8S_PROD_K8S_OPAQUE_SECRETS=minio-tls:public.crt:private.key
K8S_PROD_K8S_RESTART=ingress-nginx/deployment/ingress-nginx-controller,minio/deployment/minio
K8S_PROD_VERIFY=:443,:30090


# ===== Example 4: only copy the files (no TLS service yet) ===================
# CREATE=true allows creating files/folders that do not exist yet.
# Without it a missing path is treated as a typo and stops the run.
DB_PROD_GROUP=prod
DB_PROD_HOST=10.0.0.40
DB_PROD_USER=admin
DB_PROD_PASSWORD=
DB_PROD_TARGETS=files
DB_PROD_FILES_CERT=/etc/ssl/certs/example.com.crt
DB_PROD_FILES_KEY=/etc/ssl/private/example.com.key
DB_PROD_FILES_CREATE=true
